FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY frontend/ ./
RUN npm ci && npm run typecheck && npm run build:demo

FROM nginx:stable-alpine@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c
COPY deploy/nginx.demo.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/apps/admin/dist-demo/ /html/admin/
COPY --from=build /build/apps/h5/dist-demo/ /html/h5/
COPY frontend/apps/shared/tokens.css /html/demo-access-tokens.css
